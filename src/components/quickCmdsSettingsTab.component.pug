h3 {{ t('settings.title') }}

.form-group
    label.qc-enable-toggle.mb-0([title]='t("settings.enableTitle")')
        input(type='checkbox', [checked]='config.store.qc.enabled !== false', (change)='toggleEnabled($event)')
        span.ml-2 {{ t('settings.enable') }}
    p.text-muted.mt-3.mb-0 {{ t('settings.enableHint') }}

.form-line.mt-4
    .header
        .title {{ t('settings.language') }}
        .description {{ t('settings.languageHint') }}
    select.form-control.qc-language-select(
        [ngModel]='config.store.qc.language || "auto"',
        (ngModelChange)='setLanguage($event)',
    )
        option(value='auto') {{ t('settings.languageAuto') }}
        option(*ngFor='let lang of languages', [value]='lang.code') {{ lang.name }}
