h3 Quick Commands

.form-group
    label.qc-enable-toggle.mb-0(title='Enable or disable the Quick Commands terminal bar')
        input(type='checkbox', [checked]='config.store.qc.enabled !== false', (change)='toggleEnabled($event)')
        span.ml-2 {{ t('settings.enable') }}
    p.text-muted.mt-3.mb-0 {{ t('settings.enableDesc') }}
