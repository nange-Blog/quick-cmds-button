.modal-header
    h4.modal-title {{ command.name ? t('command.editTitle') : t('command.newTitle') }}

.modal-body
    .form-group
        label {{ t('command.name') }}
        input.form-control(
            type='text',
            [placeholder]='t("command.namePlaceholder")',
            autofocus,
            [(ngModel)]='command.name',
        )

    .form-group
        label {{ t('command.text') }}
        textarea.form-control.qc-cmd-text(
            rows=3,
            style='white-space: pre-line',
            [placeholder]='t("command.textPlaceholder")',
            [(ngModel)]='command.text',
        )

    .form-group
        label {{ t('command.group') }}
        input.form-control(
            type='text',
            list='groupList',
            [placeholder]='t("command.groupPlaceholder")',
            [(ngModel)]='command.group',
            (focus)='onGroupFocus()',
            (blur)='onGroupBlur()',
        )
        datalist#groupList
            option([value]='') {{ t('group.ungrouped') }}
            option(*ngFor='let group of allGroups', [value]='group') {{ group }}

    .form-group
        label {{ t('command.note') }}
        input.form-control(
            type='text',
            [placeholder]='t("command.notePlaceholder")',
            [(ngModel)]='command.note',
        )

    .form-group
        label {{ t('command.color') }}
        .qc-color-swatches
            span.qc-swatch(
                *ngFor='let c of colors',
                [class.selected]='isColorSelected(c.value)',
                [class.none]='!c.value',
                [style.background]='c.value || "transparent"',
                [title]='t(c.key)',
                (click)='selectColor(c.value)',
            )

    .form-line
        .header
            .title {{ t('command.confirm') }}
            .description {{ t('command.confirmHint') }}
        toggle(
            [(ngModel)]='command.confirmBeforeRun',
        )

    .form-line
        .header
            .title {{ t('command.appendCR') }}
            .description {{ t('command.appendCRHint') }}
        toggle(
            [(ngModel)]='command.appendCR',
        )

.modal-footer
    button.btn.btn-outline-secondary((click)='cancel()') {{ t('button.cancel') }}
    button.btn.btn-primary((click)='save()') {{ t('button.save') }}
