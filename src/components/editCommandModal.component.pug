.modal-header
    h4.modal-title {{ command.name ? t('cmd.edit') : t('cmd.new') }}

.modal-body
    .form-group
        label {{ t('cmd.name') }}
        input.form-control(
            type='text',
            [placeholder]="t('cmd.namePh')",
            autofocus,
            [(ngModel)]='command.name',
        )

    .form-group
        label {{ t('cmd.text') }}
        textarea.form-control.qc-cmd-text(
            rows=3,
            style='white-space: pre-line',
            [placeholder]="t('cmd.textPh')",
            [(ngModel)]='command.text',
        )

    .form-group
        label {{ t('cmd.group') }}
        input.form-control(
            type='text',
            list='groupList',
            [placeholder]="t('cmd.groupPh')",
            [(ngModel)]='command.group',
            (focus)='onGroupFocus()',
            (blur)='onGroupBlur()',
        )
        datalist#groupList
            option([value]='') {{ t('cmd.ungrouped') }}
            option(*ngFor='let group of allGroups', [value]='group') {{ group }}

    .form-group
        label {{ t('cmd.note') }}
        input.form-control(
            type='text',
            [placeholder]="t('cmd.notePh')",
            [(ngModel)]='command.note',
        )

    .form-group
        label {{ t('cmd.color') }}
        .qc-color-swatches
            span.qc-swatch(
                *ngFor='let c of colors',
                [class.selected]='isColorSelected(c.value)',
                [class.none]='!c.value',
                [style.background]='c.value || "transparent"',
                [title]='c.name',
                (click)='selectColor(c.value)',
            )

    .form-line
        .header
            .title {{ t('cmd.confirm') }}
            .description {{ t('cmd.confirmDesc') }}
        toggle(
            [(ngModel)]='command.confirmBeforeRun',
        )

    .form-line
        .header
            .title {{ t('cmd.appendCR') }}
            .description {{ t('cmd.appendCRDesc') }}
        toggle(
            [(ngModel)]='command.appendCR',
        )

.modal-footer
    button.btn.btn-outline-secondary((click)='cancel()') {{ t('common.cancel') }}
    button.btn.btn-primary((click)='save()') {{ t('common.save') }}
