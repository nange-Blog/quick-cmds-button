.modal-header
    h4.modal-title {{ command.name ? '编辑命令' : '新建命令' }}

.modal-body
    .form-group
        label 名称
        input.form-control(
            type='text',
            placeholder='给命令起个名字',
            autofocus,
            [(ngModel)]='command.name',
        )

    .form-group
        label 命令内容
        textarea.form-control.qc-cmd-text(
            rows=3,
            style='white-space: pre-line',
            placeholder='要发送到终端的命令',
            [(ngModel)]='command.text',
        )

    .form-group
        label 分组
        input.form-control(
            type='text',
            list='groupList',
            placeholder='选择或输入分组名',
            [(ngModel)]='command.group',
            (focus)='onGroupFocus()',
            (blur)='onGroupBlur()',
        )
        datalist#groupList
            option([value]='') 未分组
            option(*ngFor='let group of allGroups', [value]='group') {{ group }}

    .form-group
        label 备注
        input.form-control(
            type='text',
            placeholder='可选，悬停按钮时显示',
            [(ngModel)]='command.note',
        )

    .form-group
        label 颜色
        .qc-color-swatches
            span.qc-swatch(
                *ngFor='let c of colors',
                [class.selected]='isColorSelected(c.value)',
                [class.none]='!c.value',
                [style.background]='c.value || "transparent"',
                [title]='c.name',
                (click)='selectColor(c.value)',
            )

    .form-line
        .header
            .title 执行前二次确认
            .description 开启后点击此命令会先弹出确认框，防止误触
        toggle(
            [(ngModel)]='command.confirmBeforeRun',
        )

    .form-line
        .header
            .title 自动回车
            .description 发送后自动追加换行符执行
        toggle(
            [(ngModel)]='command.appendCR',
        )

.modal-footer
    button.btn.btn-outline-secondary((click)='cancel()') 取消
    button.btn.btn-primary((click)='save()') 保存
